<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <add key="github" value="https://nuget.pkg.github.com/TurtleHacksz/index.json" />
    </packageSources>
    <packageSourceCredentials>
        <github>
            <add key="Username" value="TurtleHacksz" />
            <add key="ClearTextPassword" value="YOUR-GITHUB-PAT" />
        </github>
    </packageSourceCredentials>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="github">
            <package pattern="TurtleHacksz.*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
